# --- Required ---
# Any PostgreSQL 14+ connection string (Neon / Supabase / Azure Database / RDS)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Optional ---
# Set to "false" for a local Postgres without TLS
DATABASE_SSL=false

# Identifies which deployment answered the request: azure | aws | local
APP_REGION=local
APP_DEPLOYMENT=local
APP_VERSION=dev

# Azure Traffic Manager hostname (used in the failover docs)
PRIMARY_HOSTNAME=app.example.com
